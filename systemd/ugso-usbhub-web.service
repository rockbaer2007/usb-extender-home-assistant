[Unit]
Description=UGSo USB Hub - optional configuration web interface
After=network.target

[Service]
Type=simple
User=ugso-usbhub
Group=ugso-usbhub
Environment=UGSO_USB_HOME=/var/lib/ugso-usbhub
Environment=UGSO_USB_STATUS=/run/ugso-usbhub/status.json
WorkingDirectory=/opt/ugso-usbhub/current
ExecStart=/opt/ugso-usbhub/current/.venv/bin/ugso-usbhub serve-web
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ugso-usbhub
PrivateTmp=true
TimeoutStopSec=10
MemoryMax=384M

[Install]
WantedBy=multi-user.target
